# ==============================================================================
# Database Configuration
# ==============================================================================
# Local SQLite database file path used by Prisma
DATABASE_URL="file:./dev.db"

# ==============================================================================
# NextAuth.js Configuration
# ==============================================================================
# Canonical URL of the application in development
NEXTAUTH_URL="http://localhost:3000"

# Secret used to encrypt session tokens and cookies. 
# Generate a strong secret on Windows by running:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="CHANGE_ME"

# ==============================================================================
# Social Authentication Providers (Google & GitHub)
# ==============================================================================
# Google OAuth Client Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID="CHANGE_ME"
GOOGLE_CLIENT_SECRET="CHANGE_ME"

# GitHub OAuth App Credentials (from GitHub Developer Settings)
GITHUB_CLIENT_ID="CHANGE_ME"
GITHUB_CLIENT_SECRET="CHANGE_ME"

